Output demo/upload-demo.gif

Set FontSize 22
Set Width 1200
Set Height 600
Set Theme "Catppuccin Mocha"
Set Padding 20
Set TypingSpeed 50ms
Set Shell fish

Require node

Hide
Type "function gitshot; node /Users/vipulgupta2048/gitshot/dist/index.js $argv; end"
Enter
Type "cd /Users/vipulgupta2048/gitshot"
Enter
Sleep 1s
Type "clear"
Enter
Sleep 500ms
Show

Type "# Simple upload — returns markdown"
Enter
Sleep 600ms

Type "gitshot rick.gif"
Enter
Sleep 10s

Sleep 300ms

Type "# Raw URL for scripting"
Enter
Sleep 600ms

Type "gitshot --raw rick.gif"
Enter
Sleep 10s

Sleep 300ms

Type "# JSON for agents"
Enter
Sleep 600ms

Type "gitshot --json rick.gif"
Enter
Sleep 10s

Sleep 2s
